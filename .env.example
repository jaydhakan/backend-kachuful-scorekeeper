# Copy to .env for local development. Real environment variables win over this file.
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://kachuful:kachuful@localhost:5433/kachuful
TEST_DATABASE_URL=postgresql+asyncpg://kachuful:kachuful@localhost:5433/kachuful_test
APP_ORIGIN=http://localhost:5173
APP_TZ=Asia/Kolkata
SEED_ADMIN_EMAIL=jaydhakan11@gmail.com
SESSION_DAYS=180
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
WEB_CONCURRENCY=2
OG_CACHE_DIR=var/og-cache
BACKUP_DIR=var/backups
# rclone remote for off-VPS copies, e.g. b2:kachuful-backups (empty = local only)
BACKUP_REMOTE=
