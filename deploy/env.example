# /srv/kachuful/<staging|production>/shared/env  (owner deploy, chmod 600). Never commit real values.
APP_ENV=staging
DATABASE_URL=postgresql+asyncpg://kachuful_staging:CHANGE_ME@127.0.0.1:5432/kachuful_staging
APP_ORIGIN=https://staging.play.vectanix.com
APP_TZ=Asia/Kolkata
SEED_ADMIN_EMAIL=jaydhakan11@gmail.com
SESSION_DAYS=180
LOG_LEVEL=INFO
HOST=127.0.0.1
# 8001 for staging, 8000 for production (must match the nginx config)
PORT=8001
WEB_CONCURRENCY=2
DB_POOL_SIZE=10
OG_CACHE_DIR=/srv/kachuful/staging/shared/og-cache
BACKUP_DIR=/srv/kachuful/staging/shared/backups
# rclone remote for off-VPS copies, e.g. b2:kachuful-backups/staging (empty = local only)
BACKUP_REMOTE=
