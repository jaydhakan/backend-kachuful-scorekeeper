# /srv/kachuful/production/shared/env  (owner deploy, chmod 600). Never commit real values.
APP_ENV=production
DATABASE_URL=postgresql+asyncpg://kachuful_production:CHANGE_ME@127.0.0.1:5432/kachuful_production
APP_ORIGIN=https://play.vectanix.com
APP_TZ=Asia/Kolkata
SEED_ADMIN_EMAIL=jaydhakan11@gmail.com
SESSION_DAYS=180
LOG_LEVEL=INFO
HOST=127.0.0.1
# Must match proxy_pass in deploy/nginx/kachuful-api.conf
PORT=8000
WEB_CONCURRENCY=2
DB_POOL_SIZE=10
OG_CACHE_DIR=/srv/kachuful/production/shared/og-cache
BACKUP_DIR=/srv/kachuful/production/shared/backups
# rclone remote for off-VPS copies, e.g. b2:kachuful-backups/production (empty = local only)
BACKUP_REMOTE=
