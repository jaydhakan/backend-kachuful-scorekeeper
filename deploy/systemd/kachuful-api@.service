# One instance per environment: kachuful-api@staging, kachuful-api@production.
[Unit]
Description=Kachuful API (%i)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/srv/kachuful/%i/current
EnvironmentFile=/srv/kachuful/%i/shared/env
EnvironmentFile=-/srv/kachuful/%i/current/.release-env
ExecStart=/srv/kachuful/%i/current/.venv/bin/python -m app
Restart=always
RestartSec=2
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
