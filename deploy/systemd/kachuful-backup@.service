# kachuful-backup@staging / kachuful-backup@production: pg_dump, rotate, copy off the VPS
[Unit]
Description=Kachuful backup (%i)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/kachuful/%i/current
EnvironmentFile=/srv/kachuful/%i/shared/env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/kachuful/%i/current/.venv/bin/python -m app.cli backup
NoNewPrivileges=true
