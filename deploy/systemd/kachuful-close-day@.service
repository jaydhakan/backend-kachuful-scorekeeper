# kachuful-close-day@staging / kachuful-close-day@production: freeze yesterday's daily awards
[Unit]
Description=Kachuful close-day (%i)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/kachuful/%i/current
EnvironmentFile=/srv/kachuful/%i/shared/env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/kachuful/%i/current/.venv/bin/python -m app.cli close-day
NoNewPrivileges=true
