# kachuful-auto-end@staging / kachuful-auto-end@production: end games idle for 24 hours
[Unit]
Description=Kachuful auto-end (%i)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/kachuful/%i/current
EnvironmentFile=/srv/kachuful/%i/shared/env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/kachuful/%i/current/.venv/bin/python -m app.cli auto-end
NoNewPrivileges=true
